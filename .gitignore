.venv/
**/__pycache__/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Archives / large downloads
*.zip
*.pdf

# --- Data / artifacts (keep repo small) ---
# Ignore everything under data/ by default (datasets, caches, outputs)
data/**

# Unignore the specific adapter we want to publish (small ~MBs)
!data/
!data/adapters/
!data/adapters/mcq224_cont_r2_last16_letter_meta_e2/
!data/adapters/mcq224_cont_r2_last16_letter_meta_e2/**

# Keep the rest of data/ ignored
data/images/
data/runs/
data/results/
data/logs/
data/.hf_home/
outputs/
log/

# Common generated files
submission.csv
data/submission_*.csv
data/val_*.csv
data/train_*.csv
data/*scores*.csv
data/*eval*.csv

# Local scratch notebooks
starter_notebook (1).ipynb

# Keep docs + configs tracked (do NOT ignore *.md / *.txt / *.json globally)